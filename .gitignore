__pycache__/
*.py[cod]
.venv/
*.gcode
*.log
render-preview/
.DS_Store

# Native bespoke review exports are packaged as release assets.
bench/reviews/bespoke-tools-v1/*/*.step
bench/reviews/bespoke-tools-v1/*/*.stl
bench/reviews/bespoke-tools-v1/*/*.FCStd
bench/reviews/bespoke-tools-v1/*/*.FCBak
bench/reviews/bespoke-tools-v1/*/*.glb
# CF01 v2 native exports are distributed in its immutable CAD release.
bench/reviews/cascade-funnels-v2/*/*.step
bench/reviews/cascade-funnels-v2/*/*.stl
bench/reviews/cascade-funnels-v2/*/*.FCStd
bench/reviews/cascade-funnels-v2/*/*.FCBak
bench/reviews/cascade-funnels-v2/*/*.glb

# CF01 v3 native exports are distributed in its immutable CAD release.
bench/reviews/cascade-funnels-v3/*/*.step
bench/reviews/cascade-funnels-v3/*/*.stl
bench/reviews/cascade-funnels-v3/*/*.FCStd
bench/reviews/cascade-funnels-v3/*/*.FCBak
bench/reviews/cascade-funnels-v3/*/*.glb

# HX02 native exports are packaged as immutable release assets.
bench/reviews/canted-hex-keys-v1/*/*.step
bench/reviews/canted-hex-keys-v1/*/*.stl
bench/reviews/canted-hex-keys-v1/*/*.FCStd
bench/reviews/canted-hex-keys-v1/*/*.FCBak
bench/reviews/canted-hex-keys-v1/*/*.glb
